# Web quản trị SDFish — env cần khi deploy (Vercel project riêng, root = admin/)
# Supabase DÙNG CHUNG với app ngư dân (project znzgugvfhgmiszqgjulk):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SĐT quản trị viên, phẩy ngăn cách:
ADMIN_PHONES=
# Địa chỉ app ngư dân (tab Dữ liệu kiểm tra nguồn qua đây):
FORFISH_APP_URL=https://forfish.vercel.app
# Shared secret gọi /api/fish-forecast xuyên khoá premium — PHẢI set CÙNG GIÁ TRỊ
# ở cả app chính (Vercel forfish) lẫn web này:
ADMIN_API_KEY=
