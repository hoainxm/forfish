{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "forfish-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "forfish-dev-file",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "MARKET_STORE": "file",
        "KAIROS_INGEST_KEY": "dev-kairos-ingest-key-0123456789abcdefgh"
      },
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "forfish-dev-webpack",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--webpack"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "forfish-dev-qwen",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--webpack"
      ],
      "env": {
        "ASSISTANT_ENGINE": "qwen",
        "QWEN_BASE_URL": "http://localhost:11434/v1"
      },
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "forfish-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "forfish-cho",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:cho"
      ],
      "port": 3020,
      "autoPort": true
    },
    {
      "name": "forfish-dev-sen-bien-tat",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "NEXT_PUBLIC_SEN_BIEN": "0"
      },
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "forfish-dev-3056",
      "url": "http://localhost:3056",
      "port": 3056
    },
    {
      "name": "forfish-cho-sen-bien",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:cho"
      ],
      "env": {
        "CREW_CCCD_PEPPER": "dev-chi-thu-sen-bien-khong-phai-muoi-that"
      },
      "port": 3020,
      "autoPort": true
    }
  ]
}
