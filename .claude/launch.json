{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "forfish-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "forfish-dev-webpack",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--webpack"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "forfish-dev-qwen",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--webpack"
      ],
      "env": {
        "ASSISTANT_ENGINE": "qwen",
        "QWEN_BASE_URL": "http://localhost:11434/v1"
      },
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "forfish-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "forfish-cho",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:cho"
      ],
      "port": 3020,
      "autoPort": true
    }
  ]
}
